# ==============================================================================
# CLOUD4GREEN NEXUS WITH APACHE GUACAMOLE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace all placeholders with your production values.
# NEVER commit the actual .env file or credentials to source control.
# ==============================================================================

# Application Branding & Ports
APP_NAME="Cloud4Green Nexus with Apache Guacamole"
APP_ENV=production
PORT=8000
FRONTEND_PORT=3001

# Database Configuration (PostgreSQL in Docker / SQLite fallback for development)
# Docker compose default: postgresql://nexus:${POSTGRES_PASSWORD}@db:5432/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-secure-database-password-min-16-chars
POSTGRES_DB=nexus
DATABASE_URL=postgresql://nexus:replace-with-a-secure-database-password-min-16-chars@db:5432/nexus

# Security & Cryptography (Generate with: openssl rand -hex 32)
# Used for JWT tokens, session hashing, and symmetric Fernet encryption of VM credentials
SECRET_KEY=replace-with-a-64-character-random-hex-string-from-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Initial Administrator Seed (Created automatically on first startup if no admin exists)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password-min-12-chars

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:80,http://localhost:8000

# VMware vCenter / ESXi Integration
# Set to true when connected to your real VMware vCenter infrastructure
VMWARE_ENABLED=false

# Apache Guacamole Daemon (guacd) Configuration
# Host and port of the guacd service container or daemon
GUACD_HOST=guacd
GUACD_PORT=4822
GUACD_CONNECT_TIMEOUT_SEC=10

